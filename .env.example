# Copy this file to .env and fill in your own values:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# .env is listed in .gitignore and should never be committed — it's the
# one file in this project that can hold a real secret.

# ---------------------------------------------------------------------
# Groq API (required only for AI scenario interpretation + AI Insights).
# Get a free key at https://console.groq.com/keys
# Leave GROQ_API_KEY blank to run LeaseSynth AI with manual (form-based)
# generation only — every other feature works fully without it.
# ---------------------------------------------------------------------
GROQ_API_KEY=

# Verify this is still a currently-supported model id before relying on
# it: https://console.groq.com/docs/models (Groq periodically retires
# older model ids). This was the correct id for Llama 3.3 70B at the
# time this project was built.
GROQ_MODEL=llama-3.3-70b-versatile

GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# ---------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ---------------------------------------------------------------------
# Generation limits
# ---------------------------------------------------------------------
MIN_RECORDS=1
MAX_RECORDS=20000
